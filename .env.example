# =====================================================================
# Autars - environment variables
# Copy this file to `.env.local` and fill the values.
# =====================================================================

# --- LLM (vendor-agnostic, server-side) ---
# Every server-side LLM call goes through server/llmClient.ts, which uses
# the OpenAI SDK pointed at any OpenAI-compatible endpoint. Swap providers
# by changing these three vars — no code change required.
#
# Examples:
#   Anthropic Claude (OpenAI-compatible endpoint):
#     LLM_BASE_URL=https://api.anthropic.com/v1/
#     LLM_API_KEY=sk-ant-...
#     LLM_MODEL=claude-sonnet-4-5
#
#   OpenAI:
#     LLM_BASE_URL=https://api.openai.com/v1/
#     LLM_API_KEY=sk-...
#     LLM_MODEL=gpt-4o
#
#   Local open-source via Ollama (no key required):
#     LLM_BASE_URL=http://localhost:11434/v1/
#     LLM_API_KEY=ollama
#     LLM_MODEL=llama3.1:70b
#
#   vLLM, LM Studio, llama.cpp server, OpenRouter, Together, Groq, etc.
#   work the same way as long as they expose a Chat Completions endpoint.
LLM_BASE_URL=https://api.anthropic.com/v1/
LLM_API_KEY=sk-ant-...
LLM_MODEL=claude-sonnet-4-5

# Legacy fallback. If LLM_API_KEY is missing, the server falls back to this
# so existing .env.local files keep working during the migration.
# ANTHROPIC_API_KEY=sk-ant-...

# --- Supabase (frontend client) ---
# Required to switch the app from local mock data to real persisted data.
# Find them in Supabase Dashboard > Project Settings > API.
# Use the `anon public` key here — NEVER the service role key.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# --- Supabase (server-side only, NEVER prefixed VITE_) ---
# Required for the real agent runner: the Vite middleware /api/agents/*
# uses this to write into agent_runs / deliverables / decisions on behalf
# of the user. Get it in Supabase Dashboard > Project Settings > API
# under "service_role". Never expose this key to the browser.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
# Optional fallback for the server (defaults to VITE_SUPABASE_ANON_KEY):
# SUPABASE_ANON_KEY=eyJhbGciOi...
