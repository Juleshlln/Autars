# =====================================================================
# Autars - environment variables
# Copy this file to `.env.local` and fill the values.
# =====================================================================

# --- LLM (vendor-agnostic, server-side) ---
# Every server-side LLM call goes through server/llmClient.ts, which uses
# the OpenAI SDK pointed at any OpenAI-compatible endpoint. Swap providers
# by changing these three vars — no code change required.
#
# Examples:
#   Anthropic Claude (OpenAI-compatible endpoint):
#     LLM_BASE_URL=https://api.anthropic.com/v1/
#     LLM_API_KEY=sk-ant-...
#     LLM_MODEL=claude-sonnet-4-5
#
#   OpenAI:
#     LLM_BASE_URL=https://api.openai.com/v1/
#     LLM_API_KEY=sk-...
#     LLM_MODEL=gpt-4o
#
#   Local open-source via Ollama (no key required):
#     LLM_BASE_URL=http://localhost:11434/v1/
#     LLM_API_KEY=ollama
#     LLM_MODEL=llama3.1:70b
#
#   vLLM, LM Studio, llama.cpp server, OpenRouter, Together, Groq, etc.
#   work the same way as long as they expose a Chat Completions endpoint.
LLM_BASE_URL=https://api.anthropic.com/v1/
LLM_API_KEY=sk-ant-...
LLM_MODEL=claude-sonnet-4-5

# Legacy fallback. If LLM_API_KEY is missing, the server falls back to this
# so existing .env.local files keep working during the migration.
# ANTHROPIC_API_KEY=sk-ant-...

# --- Supabase (frontend client) ---
# Required to switch the app from local mock data to real persisted data.
# Find them in Supabase Dashboard > Project Settings > API.
# Use the `anon public` key here — NEVER the service role key.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# --- Supabase (server-side only, NEVER prefixed VITE_) ---
# Required for the real agent runner: the Vite middleware /api/agents/*
# uses this to write into agent_runs / deliverables / decisions on behalf
# of the user. Get it in Supabase Dashboard > Project Settings > API
# under "service_role". Never expose this key to the browser.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
# Optional fallback for the server (defaults to VITE_SUPABASE_ANON_KEY):
# SUPABASE_ANON_KEY=eyJhbGciOi...

# --- Embeddings / RAG memory (server-side only) ---
# Used by server/memory.ts to embed deliverables into agent_memories
# (pgvector) and by the `search_memory` agent tool to RAG-recall them.
# The embedding API is intentionally separate from the chat LLM (LLM_*
# above) because the main LLM might be Claude (no embeddings endpoint).
# A free OpenAI key with text-embedding-3-small access is enough.
# If neither key is set, indexing and search are silently no-op and
# the rest of the agent still works.
OPENAI_EMBED_API_KEY=sk-...
# Optional fallback (re-uses your generic OpenAI key if you already have one):
# OPENAI_API_KEY=sk-...
# Optional override (e.g. point at Azure OpenAI, OpenRouter, etc.):
# OPENAI_EMBED_BASE_URL=https://api.openai.com/v1/

# --- Outbound action tools (server-side only) ---
# Default destination for the `trigger_webhook` agent tool when the LLM
# does not pass an explicit target_url. Use a Make.com / Zapier / n8n
# scenario webhook URL.
MAKE_WEBHOOK_URL=https://hook.eu1.make.com/your-scenario-id

# Brevo (ex-Sendinblue) transactional email — used by `send_email_brevo`.
# Get a key in Brevo > SMTP & API > API keys.
# If BREVO_API_KEY is missing the tool returns a mocked success so the
# agent loop can still be exercised end-to-end in dev.
BREVO_API_KEY=xkeysib-...
BREVO_DEFAULT_FROM_EMAIL=hello@your-domain.com
BREVO_DEFAULT_FROM_NAME=Autars

# Vercel API token — used by `deploy_vercel_site` for static deploys.
# Generate at https://vercel.com/account/tokens. Optional VERCEL_TEAM_ID
# is required if the token is scoped to a team.
VERCEL_TOKEN=
# VERCEL_TEAM_ID=team_...

# --- Stripe webhook (server-side only) ---
# Endpoint: POST /api/stripe/webhook
# Configure in Stripe Dashboard > Developers > Webhooks. Subscribe to:
#   * checkout.session.completed
#   * invoice.payment_succeeded
# Stripe will give you the signing secret (whsec_...). Pass the
# authenticated user id as `client_reference_id` on the Checkout Session
# (or as `metadata.user_id`) so the webhook can resolve it.
# Optional: set `metadata.plan_id` (mapped to the `plans` table) OR
# `metadata.credits` for an explicit grant. Otherwise STRIPE_DEFAULT_CREDITS
# is granted (50000 by default).
STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_DEFAULT_CREDITS=50000
