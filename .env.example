# Anthropic API key — required for real AI agents.
# Get one at https://console.anthropic.com/
# Copy this file to .env.local and fill in your key.
#
# IMPORTANT: NO `VITE_` prefix — the key stays server-side via the Vite
# /api/llm/* proxy. It is never exposed to the browser bundle.
ANTHROPIC_API_KEY=sk-ant-...
