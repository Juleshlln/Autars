# =====================================================================
# Autars - environment variables
# Copy this file to `.env.local` and fill the values.
# =====================================================================

# --- Anthropic (LLM proxy, server-side) ---
# Required for real AI agents. NO `VITE_` prefix on purpose: the key stays
# server-side via the Vite /api/llm/* proxy and is never exposed to the
# browser bundle. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# --- Supabase (frontend client) ---
# Required to switch the app from local mock data to real persisted data.
# Find them in Supabase Dashboard > Project Settings > API.
# Use the `anon public` key here — NEVER the service role key.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# --- Supabase (server-side only, NEVER prefixed VITE_) ---
# Required for the real agent runner: the Vite middleware /api/agents/*
# uses this to write into agent_runs / deliverables / decisions on behalf
# of the user. Get it in Supabase Dashboard > Project Settings > API
# under "service_role". Never expose this key to the browser.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
# Optional fallback for the server (defaults to VITE_SUPABASE_ANON_KEY):
# SUPABASE_ANON_KEY=eyJhbGciOi...
